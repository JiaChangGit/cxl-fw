# Boot/rootfs/console and standard systemd init.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_WERROR is not set
CONFIG_MODULES=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_ACPI=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_CGROUPS=y
CONFIG_FHANDLE=y
CONFIG_UNIX=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_INOTIFY_USER=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y

# CXL volatile RAM -> DAX/kmem. DEV_DAX needs THP compiled in;
# workload/boot disables THP at runtime for 4 KiB measurements.
CONFIG_NUMA=y
CONFIG_ACPI_NUMA=y
CONFIG_MIGRATION=y
CONFIG_COMPACTION=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_DAX=y
CONFIG_DEV_DAX=y
# device_dax devm_memremap_pages() requires ZONE_DEVICE, including teardown to devdax.
CONFIG_ZONE_DEVICE=y
CONFIG_DEV_DAX_CXL=y
CONFIG_DEV_DAX_KMEM=y
CONFIG_CXL_BUS=y
CONFIG_CXL_PCI=y
CONFIG_CXL_ACPI=y
CONFIG_CXL_MEM=y
CONFIG_CXL_PORT=y
CONFIG_CXL_REGION=y
# QEMU-only test kernel: x86 refuses WBINVD region invalidation under a hypervisor.
# This upstream test option permits emulated region setup; no physical cache claim.
CONFIG_CXL_REGION_INVALIDATION_TEST=y
# CONFIG_CXL_MEM_RAW_COMMANDS is not set

# Existing kernel tracepoints; no instrumentation patches in M0.
CONFIG_DEBUG_FS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_TRACEPOINTS=y
CONFIG_EVENT_TRACING=y
CONFIG_KALLSYMS=y
